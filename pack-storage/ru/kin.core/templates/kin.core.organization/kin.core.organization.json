{
  "format": "kintion-pack/0",
  "source": "kin.core",
  "id": "kin.core.organization",
  "entity": "kin.core.organization",
  "name": "Организация",
  "title": [
    { "field": "@legal_form" },
    { "string": " «", "if": "legal_form" },
    { "field": "name" },
    { "string": "»", "if": "legal_form" }
  ],
  "sort_by": ["name"],
  "fields": [
