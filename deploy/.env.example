# Copy to .env and change the values. Never commit .env.
# All application variables use the TEO_KIN_ prefix. Uncommented ones are the
# main settings, commented ones are optional (the default is shown).

# --- Main ---

# PostgreSQL password (Compose only; not passed to the application).
# Set it before the first start: it is stored in the kintion-db volume and
# changing it here later does not change the database.
TEO_KIN_DB_PASSWORD=

# Application port: the same on the host and in the container (Compose: port only).
# Bind to a host interface (127.0.0.1) in "ports" of your compose file.
# Without Compose a full address also works: 127.0.0.1:18080, [::1]:18080, :18080.
TEO_KIN_HTTP_BIND=8080

# Public address (used for Secure cookies and Origin checks), e.g. https://kin.example.com
TEO_KIN_PUBLIC_URL=

# --- Optional ---

# Log level: debug | info | warn | error
# TEO_KIN_LOG_LEVEL=info

# Instance language: ru | en
# TEO_KIN_LANGUAGE=en

# Enabled packs, comma-separated (dependencies are added automatically),
# e.g. kin.core,kin.christian.orthodox
# TEO_KIN_PACKS=kin.core

# External PostgreSQL instead of the bundled one (the bundled one still starts).
# Default: the bundled db service with TEO_KIN_DB_PASSWORD.
# TEO_KIN_DATABASE_URL=postgres://user:password@host:5432/kintion?sslmode=require
# Or a secret file instead of the URL (not both). Only for runs without the stock
# compose: its backup and restore services read TEO_KIN_DATABASE_URL, so in compose
# set the URL, not _FILE.
# TEO_KIN_DATABASE_URL_FILE=/run/secrets/db

# Upload size limit (photos), MB: 1..1024
# TEO_KIN_UPLOAD_MAX_MB=20

# Sign-in: only local and closed are supported (a single owner account)
# TEO_KIN_AUTH_MODE=local
# TEO_KIN_REGISTRATION=closed

# Version stamped into the image and the change log (Compose, at build time)
# TEO_KIN_VERSION=dev

# --- Runs without Compose only (compose.yml does not pass these) ---

# Files folder (a /data volume in the container)
# TEO_KIN_STORAGE_PATH=/data

# Path to a YAML settings file (lower priority than environment variables). Not set by default
# TEO_KIN_CONFIG=/etc/kintion/config.yml

# Read packs from disk (<path>/<language>/<pack>/...) instead of the embedded ones — for pack development. Not set by default (embedded)
# TEO_KIN_PACKS_PATH=
